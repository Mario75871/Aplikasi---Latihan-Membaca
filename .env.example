# BacaLaras Frontend Environment Variables

# Base URL backend FastAPI.
# Di server component dibaca sebagai API_BASE_URL (opsional, prioritas utama).
# Di browser dibaca sebagai NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Opsional: base URL khusus server component (mis. alamat internal di produksi).
# API_BASE_URL=http://backend:8000
