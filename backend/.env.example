# BacaLaras Backend Environment Variables

# === Whisper Model Configuration (D12) ===
# Model size: tiny, base (default), small, medium, large
WHISPER_MODEL=base

# Device: cpu (default), cuda
WHISPER_DEVICE=cpu

# Compute type: int8 (default, CPU), float16 (GPU), float32
WHISPER_COMPUTE_TYPE=int8

# CPU threads for faster-whisper
WHISPER_CPU_THREADS=4

# === Demo Mode (1A.6) ===
# Set to true untuk mode demo tanpa model (putar ulang hasil framework)
# Default: false
DEMO_FALLBACK=false

# === CORS (Fase 2) ===
# Comma-separated origins, atau * untuk semua (jangan di produksi)
# CORS_ORIGINS=http://localhost:3000,https://bacalaras.vercel.app

# === Environment (integrasi #4, C.3) ===
# development | staging | production. Produksi menolak AUTH_DISABLED & butuh TLS.
# ENV=development

# === Rate limiting (integrasi #4, D4) ===
# Jalur guru (per-guru) & per-IP. Batas awal bila env kosong.
# RATE_LIMIT_AUDIO_TEACHER=10      # upload/transkripsi per guru / jendela
# RATE_LIMIT_AUDIO_IP=30           # upload/transkripsi per IP / jendela
# RATE_LIMIT_LOGIN_IP=20           # login per IP / jendela
# RATE_LIMIT_POLL_TEACHER=120      # polling status per guru / menit
# RATE_LIMIT_AUDIO_WINDOW_SEC=600
# RATE_LIMIT_LOGIN_WINDOW_SEC=600
# RATE_LIMIT_POLL_WINDOW_SEC=60

# Pendaftaran akun (integrasi #7). Ketat dengan sengaja: tiap panggilan /start
# mengirim satu email nyata. Per-email ditegakkan di endpoint, per-IP di middleware.
# RATE_LIMIT_SIGNUP_IP=5             # /auth/signup/start per IP / jendela
# RATE_LIMIT_SIGNUP_EMAIL=3          # /auth/signup/start per email / jendela
# RATE_LIMIT_SIGNUP_VERIFY_IP=20     # /auth/signup/verify per IP / jendela
# RATE_LIMIT_SIGNUP_VERIFY_EMAIL=10  # /auth/signup/verify per email / jendela
# RATE_LIMIT_SIGNUP_WINDOW_SEC=600

# === Supabase (Fase 2) ===
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key            # DIPAKAI jalur guru (RLS ditegakkan)
# Integrasi #3 (D1 hybrid): key service-role untuk ADMIN/seed (BYPASS RLS).
# SERVER-ONLY — jangan pernah kirim ke klien/frontend.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opsional: verifikasi JWT lokal (tanpa round-trip ke Supabase). Bila kosong,
# token diverifikasi via client.auth.get_user(jwt).
# SUPABASE_JWT_SECRET=your-jwt-secret

# === Batas upload audio (integrasi #3, D4) ===
# Ukuran maksimum per file (byte). Default: 10485760 (10 MB).
# MAX_AUDIO_BYTES=10485760
# Format audio yang diterima (integrasi #3, D4): WAV & MP3 saja.
# AUDIO_ALLOWED_FORMATS=wav,mp3

# === Audio: konvensi & penyimpanan (integrasi #4, D2 / B.4) ===
# Sample rate target input ASR (Hz). Klien menormalkan rekaman ke nilai ini.
# TARGET_SAMPLE_RATE=16000
# Bucket Supabase Storage PRIVATE untuk audio siswa. Path: {teacher_id}/{assessment_id}/...
# AUDIO_STORAGE_BUCKET=reading-audio
# Umur signed URL akses audio (detik). Berumur pendek, bukan URL publik.
# AUDIO_SIGNED_URL_TTL_SEC=600
# Cookie sesi (integrasi #4, D5): set 'true' HANYA bila sudah HTTPS.
# SESSION_COOKIE_SECURE=false

# === Integrasi #5 (produksi) ===
# Batas DURASI audio (detik) — melengkapi batas ukuran. Default 300 (5 menit).
# MAX_AUDIO_DURATION_SEC=300
# Batas waktu proses ASR (detik). Lewat batas → 504 (bukan menggantung). Default 120.
# ASR_TIMEOUT_SEC=120
# Retensi audio (bulan): audio lebih tua dari ini dihapus oleh scripts/prune_audio.py.
# AUDIO_RETENTION_MONTHS=12
# Level log (JSON terstruktur). DEBUG | INFO | WARNING | ERROR. Default INFO.
# LOG_LEVEL=INFO

# === Auth (D7) ===
# Login guru via Supabase Auth (JWT). Bila Supabase tidak tersedia (dev/lokal),
# fallback akun demo dari env var di bawah (JANGAN hardcode di kode).
DEMO_USERNAME=guru@demo.com
DEMO_PASSWORD=demo123

# Session TTL (jam)
SESSION_TTL_HOURS=12

# Set true untuk menonaktifkan auth middleware (HANYA untuk test/dev)
# AUTH_DISABLED=false

# === Daftar akun — pengiriman email (integrasi #7) ===
# Penyedia: Resend (gratis 3.000 email/bulan, tanpa kartu kredit).
# Verifikasi domain dulu di dashboard Resend, lalu isi tiga nilai di bawah.
# Bila kosong, fitur daftar akun NONAKTIF dan /auth/signup/* membalas 503 —
# login guru yang sudah berjalan tidak terpengaruh.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=BacaLaras <noreply@bacalaras.my.id>
# Kunci HMAC untuk kode OTP & tiket verifikasi. WAJIB diisi bila pendaftaran
# diaktifkan, dan WAJIB acak (minimal 32 byte). TIDAK ADA nilai default:
# kunci yang bisa ditebak lebih buruk daripada fitur yang mati.
#   openssl rand -hex 32
# SIGNUP_OTP_SECRET=
# SIGNUP_OTP_TTL_SEC=600       # masa berlaku kode OTP (detik)
# SIGNUP_OTP_MAX_ATTEMPTS=5    # percobaan verifikasi per kode sebelum hangus
# SIGNUP_TICKET_TTL_SEC=900    # masa berlaku tiket antara verifikasi & buat password
