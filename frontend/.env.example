# BacaLaras Frontend Environment Variables

# Base URL backend FastAPI.
# - Server component & proxy route handler membaca `API_BASE_URL` (prioritas utama).
# - Browser TIDAK perlu URL backend: panggilan lewat proxy same-origin `/api/proxy`
#   (integrasi #5, Fase 0) — token disuntik server-side. Jadi `NEXT_PUBLIC_API_BASE_URL`
#   umumnya TIDAK dipakai lagi.
#
# Produksi (Vercel) → URL backend publik ber-HTTPS, mis. https://api.bacalaras.example
API_BASE_URL=http://localhost:8000

# Opsional (legacy/fallback): hanya bila ada akses backend langsung dari browser.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cookie sesi httpOnly. Di Vercel (selalu HTTPS) set ke `true`.
# SESSION_COOKIE_SECURE=true
# Session TTL (jam) — sinkron dengan TTL backend.
# SESSION_TTL_HOURS=12

# Catatan (integrasi #6, D1): batas durasi & ukuran audio TIDAK di-set di frontend —
# FE membaca `GET /config/audio` dari backend saat runtime (server component). Bila
# backend tak terjangkau, FE jatuh ke konstanta cermin (`lib/audio-wav.ts`).
# Jadi TIDAK perlu env audio di Vercel; cukup backend yang mengaturnya.
